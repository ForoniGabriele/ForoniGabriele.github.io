---
// src/pages/index.astro
import Layout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <span class="hero-badge">🔐 DevOps & Cloud Security</span>
        <h1 class="hero-title">
          Gabriele <br/><span class="highlight">Foroni</span>
        </h1>
        <p class="hero-description">
          Studente di Cyber Security con una passione per l'Infrastructure as Code 
          e il cloud. Attualmente DevOps Engineer in stage presso Webranking, 
          dove progetto infrastrutture AWS resilienti e automatizzate.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">Vedi i progetti</a>
          <a href="#experience" class="btn btn-outline">Esperienza</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-shape"></div>
        <div class="hero-emoji">☁️</div>
      </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section id="experience" class="experience">
    <div class="container">
      <div class="section-header">
        <h2>Esperienza</h2>
        <p>Il mio percorso nel mondo DevOps e Cyber Security.</p>
      </div>
      
      <div class="timeline">
        <!-- Esperienza 1: DevOps Engineer -->
        <div class="timeline-item">
          <div class="timeline-badge">💼</div>
          <div class="timeline-content">
            <div class="timeline-header">
              <h3>DevOps Engineer</h3>
              <span class="company">Webranking · Stage</span>
              <span class="date">Giu 2026 - Set 2026</span>
            </div>
            <ul class="timeline-details">
              <li>Formazione AWS Cloud Practitioner Essentials e Google Cloud Fundamentals</li>
              <li>Progettazione infrastruttura AWS multi-regione con Pulumi (Python) come IaC</li>
              <li>Pipeline CI/CD, controlli DevSecOps e disaster recovery</li>
              <li>Integrazione di AI basata su Amazon Bedrock per remediation automatica</li>
            </ul>
            <div class="timeline-tags">
              <span class="tag">AWS</span>
              <span class="tag">Pulumi</span>
              <span class="tag">Python</span>
              <span class="tag">CI/CD</span>
              <span class="tag">Bedrock</span>
            </div>
          </div>
        </div>

        <!-- Esperienza 2: Sistemista -->
        <div class="timeline-item">
          <div class="timeline-badge">🖥️</div>
          <div class="timeline-content">
            <div class="timeline-header">
              <h3>Sistemista</h3>
              <span class="company">NETandWORK · Tempo pieno</span>
              <span class="date">Lug 2025 - Ott 2025</span>
            </div>
            <ul class="timeline-details">
              <li>Sviluppo sistema di monitoraggio PHP per router Mikrotik</li>
              <li>Documentazione e gestione infrastruttura di rete con NetBox</li>
            </ul>
            <div class="timeline-tags">
              <span class="tag">PHP</span>
              <span class="tag">Docker</span>
              <span class="tag">VMware ESX</span>
              <span class="tag">NetBox</span>
            </div>
          </div>
        </div>

        <!-- Esperienza 3: Stagista Sistemista -->
        <div class="timeline-item">
          <div class="timeline-badge">🔧</div>
          <div class="timeline-content">
            <div class="timeline-header">
              <h3>Stagista Sistemista</h3>
              <span class="company">NETandWORK · Stage</span>
              <span class="date">Feb 2025</span>
            </div>
            <ul class="timeline-details">
              <li>Configurazione server Ookla a Correggio e Bologna</li>
            </ul>
            <div class="timeline-tags">
              <span class="tag">Linux</span>
              <span class="tag">VXLAN</span>
            </div>
          </div>
        </div>

        <!-- Esperienza 4: Analista Dati -->
        <div class="timeline-item">
          <div class="timeline-badge">📊</div>
          <div class="timeline-content">
            <div class="timeline-header">
              <h3>Stagista Analista Dati</h3>
              <span class="company">NETandWORK · Stage</span>
              <span class="date">Feb 2024 - Mar 2024</span>
            </div>
            <ul class="timeline-details">
              <li>Creazione di grafici e dashboard con Grafana</li>
            </ul>
            <div class="timeline-tags">
              <span class="tag">Grafana</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="projects">
    <div class="container">
      <div class="section-header">
        <h2>Progetti</h2>
        <p>Progetti personali e professionali che raccontano il mio approccio.</p>
      </div>
      <div class="projects-grid">
        <ProjectCard 
          title="Webapp + IaC AWS"
          description="Infrastruttura AWS multi-regione per libreria online con Pulumi (Python). Include DR, pipeline CI/CD, DevSecOps e integrazione AI con Bedrock per remediation automatica. Tutto documentato in markdown."
          tags={["AWS", "Pulumi", "Python", "Bedrock", "GitHub Actions"]}
          link="#"
        />
        <ProjectCard 
          title="Sito Iscrizioni Atleti"
          description="Piattaforma per la gestione di atleti e genitori con form HTML e database. Generazione automatica di PDF per firma e stampa, gestione ricevute pagamento. Ottimizza l'efficienza amministrativa."
          tags={["HTML", "PHP", "Database", "PDF Generation"]}
          link="#"
        />
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="contact">
    <div class="container">
      <div class="contact-card">
        <div class="contact-info">
          <h2>Parliamo del tuo prossimo progetto?</h2>
          <p>
            Se cerchi un DevOps Engineer con competenze in cloud, automazione e 
            security, o vuoi semplicemente scambiare due chiacchiere su tecnologia 
            e innovazione, scrivimi pure!
          </p>
          <div class="contact-links">
            <a href="mailto:gabriele@example.com" class="btn btn-primary">Invia un'email</a>
            <a href="https://linkedin.com/in/gabriele-foroni" class="btn btn-outline" target="_blank">LinkedIn</a>
            <a href="https://github.com/ForoniGabriele" class="btn btn-outline" target="_blank">GitHub</a>
          </div>
        </div>
        <div class="contact-emoji">
          <span>🔐</span>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ===== HERO ===== */
  .hero {
    padding: 6rem 0 4rem;
    background: linear-gradient(145deg, #f8f9fa 0%, #ffffff 100%);
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .hero-badge {
    display: inline-block;
    background: #e9ecef;
    padding: 0.35rem 1rem;
    border-radius: 30px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #495057;
    margin-bottom: 1.5rem;
  }
  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    color: #212529;
  }
  .highlight {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-description {
    font-size: 1.2rem;
    line-height: 1.6;
    color: #495057;
    max-width: 540px;
    margin-bottom: 2rem;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-block;
    padding: 0.75rem 1.8rem;
    border-radius: 40px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
    border: 2px solid transparent;
    cursor: pointer;
  }
  .btn-primary {
    background: #6366f1;
    color: #ffffff;
    border-color: #6366f1;
  }
  .btn-primary:hover {
    background: #4f46e5;
    border-color: #4f46e5;
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(99,102,241,0.25);
  }
  .btn-outline {
    background: transparent;
    color: #212529;
    border-color: #dee2e6;
  }
  .btn-outline:hover {
    border-color: #6366f1;
    color: #6366f1;
    transform: translateY(-3px);
  }
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 240px;
  }
  .hero-shape {
    width: 320px;
    height: 320px;
    background: radial-gradient(circle at 30% 30%, rgba(99,102,241,0.15), rgba(139,92,246,0.05));
    border-radius: 50%;
    position: absolute;
    animation: float 8s ease-in-out infinite;
  }
  .hero-emoji {
    font-size: 6rem;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.08));
    animation: float 6s ease-in-out infinite reverse;
  }
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-16px); }
    100% { transform: translateY(0px); }
  }

  /* ===== EXPERIENCE TIMELINE ===== */
  .experience {
    padding: 5rem 0;
    background: #ffffff;
  }
  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }
  .section-header h2 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: #212529;
  }
  .section-header p {
    color: #6c757d;
    font-size: 1.1rem;
  }
  
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    padding-left: 2rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #e9ecef;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 1.5rem;
    position: relative;
  }
  .timeline-badge {
    width: 40px;
    height: 40px;
    background: #6366f1;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: white;
    position: relative;
    z-index: 1;
    box-shadow: 0 4px 12px rgba(99,102,241,0.3);
  }
  .timeline-content {
    background: #f8f9fa;
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid #f1f3f5;
    transition: all 0.2s ease;
  }
  .timeline-content:hover {
    border-color: #6366f1;
    box-shadow: 0 4px 16px rgba(0,0,0,0.04);
  }
  .timeline-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }
  .timeline-header h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #212529;
  }
  .company {
    font-weight: 500;
    color: #6366f1;
  }
  .date {
    font-size: 0.85rem;
    color: #6c757d;
    margin-left: auto;
  }
  .timeline-details {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem 0;
  }
  .timeline-details li {
    padding-left: 1.2rem;
    position: relative;
    margin-bottom: 0.4rem;
    color: #495057;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .timeline-details li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: #6366f1;
  }
  .timeline-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    background: #e9ecef;
    padding: 0.2rem 0.7rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 500;
    color: #495057;
  }

  /* ===== PROJECTS ===== */
  .projects {
    padding: 5rem 0;
    background: #f8f9fa;
  }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  /* ===== CONTACT ===== */
  .contact {
    padding: 5rem 0;
    background: #ffffff;
  }
  .contact-card {
    background: #f8f9fa;
    border-radius: 32px;
    padding: 3.5rem;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: center;
    border: 1px solid rgba(0,0,0,0.03);
  }
  .contact-info h2 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #212529;
  }
  .contact-info p {
    color: #495057;
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .contact-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .contact-emoji {
    font-size: 5rem;
    text-align: center;
    opacity: 0.7;
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }
    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-title {
      font-size: 2.5rem;
    }
    .hero-visual {
      min-height: 180px;
    }
    .hero-shape {
      width: 200px;
      height: 200px;
    }
    .hero-emoji {
      font-size: 4rem;
    }
    .contact-card {
      grid-template-columns: 1fr;
      padding: 2rem;
      text-align: center;
    }
    .contact-links {
      justify-content: center;
    }
    .section-header h2 {
      font-size: 2rem;
    }
    .timeline {
      padding-left: 1rem;
    }
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .timeline::before {
      display: none;
    }
    .timeline-badge {
      width: 32px;
      height: 32px;
      font-size: 1rem;
    }
    .timeline-header {
      flex-direction: column;
      gap: 0.2rem;
    }
    .date {
      margin-left: 0;
    }
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>